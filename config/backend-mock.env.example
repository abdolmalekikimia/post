# ---------------------------------------------------------------------------
# Delivery Network Mock baseline and timing
# ---------------------------------------------------------------------------
Integrations__Delivery NetworkApi__Mock__Scenario=Success
Integrations__Delivery NetworkApi__RegistrationPolling__TimeoutMs=5000
Integrations__Delivery NetworkApi__RegistrationPolling__IntervalMs=500
Integrations__Delivery NetworkApi__DestinationLookup__TimeoutMs=5000
Integrations__Delivery NetworkApi__Mock__RegistrationResolutionDelay=00:00:00
Integrations__Delivery NetworkApi__Mock__DestinationOverrides__59000987654321=10003

# ---------------------------------------------------------------------------
# Destination Lookup profile changes (use one profile at a time, then restart)
# ---------------------------------------------------------------------------
# TC-01/02/03/05/06:
# Integrations__Delivery NetworkApi__Mock__Scenario=Pending
#
# TC-04/07:
# Integrations__Delivery NetworkApi__Mock__Scenario=Timeout
# or:
# Integrations__Delivery NetworkApi__Mock__Scenario=Unavailable
#
# TC-08:
# Integrations__Delivery NetworkApi__Mock__Scenario=Success
# Integrations__Delivery NetworkApi__Mock__DestinationOverrides__59000987654321=12345
#
# TC-09:
# Integrations__Delivery NetworkApi__Mock__Scenario=Rejected
#
# TC-10 needs no Delivery Network profile; invalid length must be rejected before any
# external call.

# ---------------------------------------------------------------------------
# Delivery Merge / Export Before Container / Container Response / Physical Container Audit per-barcode fixtures
# ---------------------------------------------------------------------------
# ScenarioOverrides is shared by registration, destination lookup and other
# Delivery Network mock paths. Set only the barcode fixtures required by the selected
# case, and remove stale overrides before a new case.
#
# Example Delivery Merge registration outcomes:
# Integrations__Delivery NetworkApi__Mock__ScenarioOverrides__200000000000000000000002=Rejected
# Integrations__Delivery NetworkApi__Mock__ScenarioOverrides__200000000000000000000003=Timeout
# Integrations__Delivery NetworkApi__Mock__ScenarioOverrides__200000000000000000000004=Unavailable
# Integrations__Delivery NetworkApi__Mock__ScenarioOverrides__200000000000000000000005=Pending
# Integrations__Delivery NetworkApi__Mock__ScenarioOverrides__200000000000000000000006=Success
# Integrations__Delivery NetworkApi__Mock__RegistrationResolutionDelay=00:00:01
#
# For bag error cases, use the backend's ParcelErrorOverrides map:
# Integrations__Delivery NetworkApi__Mock__ParcelErrorOverrides__<barcode>=true
# Example:
# Integrations__Delivery NetworkApi__Mock__ParcelErrorOverrides__790000000000000000000001=true
# Integrations__Delivery NetworkApi__Mock__ParcelErrorOverrides__870000000000000000000010=true
# Integrations__Delivery NetworkApi__Mock__ParcelErrorOverrides__890000000000000000000001=true
#
# For Export Before Container/87/89 retry cases, keep the failed barcode override active for
# the second attempt when testing deferred failure. Remove it and restart or
# refresh the backend mock before testing retry success.

# ---------------------------------------------------------------------------
# Policy Sync invalid ConfigSnapshot profiles
# ---------------------------------------------------------------------------
# TC-03:
# Integrations__UpstreamApi__Mock__DemoSnapshots__10001__ConfigVersion=3
# Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__2__DeviceId=POLICY_SYNC-NEW-demo-device
# Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__2__DeviceToken=policy_sync-new-token
# Integrations__UpstreamApi__Mock__DemoSnapshots__10001__RoutingPolicy__IsEnabled=true
# Integrations__UpstreamApi__Mock__DemoSnapshots__10001__RoutingPolicy__AllowedDeadline=00:00:00
#
# TC-04:
# same as TC-03, but AllowedDeadline must be a negative duration accepted by
# the backend settings binder, for example -01:00:00.
#
# TC-05:
# ConfigVersion=4, IsEnabled=false, AllowedDeadline=-01:00:00. This is an
# exploratory data-quality case and should not be treated as full validation.
