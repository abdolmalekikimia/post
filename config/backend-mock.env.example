# demo backend mock configuration for the Gateway negative-test suite.
#
# These are ASP.NET Upstream environment-variable keys. Apply the values to the
# Gateway/Backend test service, then restart it so DemoSnapshots are synchronized.
# Keep one Delivery NetworkApi Mock Scenario active per run; the switch is global.

# ---------------------------------------------------------------------------
# Upstream ConfigSnapshot — healthy baseline
# ---------------------------------------------------------------------------
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__ConfigVersion=2
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Delivery NetworkCodes__0=10001
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Delivery NetworkCodes__1=10002
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Delivery NetworkCodes__2=10003
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Delivery NetworkCodes__3=10004
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Delivery NetworkCodes__4=10005

Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__0__DeviceId=demo-device
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__0__LogicalCode=TEST-01
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__0__DeviceToken=demo-token
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__0__ActivationStatus=Active

Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__1__DeviceId=CONFIGURATION_SYNC-INACTIVE-001
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__1__LogicalCode=CONFIGURATION_SYNC-INACTIVE
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__1__DeviceToken=configuration_sync-inactive-token
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__1__ActivationStatus=Inactive

Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Bindings__0__DeviceId=demo-device
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Bindings__0__IpAddress=0.0.0.0

Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Mappings__0__From=10001
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Mappings__0__To=10003
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Mappings__0__Type=Returning
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Mappings__1__From=10001
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Mappings__1__To=10002
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Mappings__1__Type=Rejected

Integrations__UpstreamApi__Mock__DemoSnapshots__10001__RoutingPolicy__IsEnabled=false
Integrations__UpstreamApi__Mock__DemoSnapshots__10001__RoutingPolicy__AllowedDeadline=02:00:00

# Configuration Sync TC-02 intentionally uses CONFIGURATION_SYNC-UNKNOWN-001, which must NOT appear
# in Devices. Policy Sync TC-03/TC-04 need Devices__2 only in their invalid
# snapshot, not in this healthy baseline:
# Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__2__DeviceId=POLICY_SYNC-NEW-demo-device
# Integrations__UpstreamApi__Mock__DemoSnapshots__10001__Devices__2__DeviceToken=policy_sync-new-token

